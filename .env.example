COMPOSE_PROJECT_NAME=racingguru

POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_CONTAINER_NAME=racingguru-postgres
POSTGRES_DB=races
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1337
POSTGRES_HOST_PORT=5433
POSTGRES_HOSTNAME=postgres
POSTGRES_CONTAINER_PORT=5432

MYSQL_IMAGE_TAG=8.4
MYSQL_CONTAINER_NAME=racingguru-mysql
MYSQL_DATABASE=races
MYSQL_USER=races
MYSQL_PASSWORD=1337
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=3306
MYSQL_HOSTNAME=mysql
MYSQL_CONTAINER_PORT=3306

MIGRATE_IMAGE_TAG=v4.18.3
MIGRATE_CONTAINER_NAME=racingguru-migrate
MIGRATE_DATABASE_URL=postgresql://postgres:1337@postgres:5432/races?sslmode=disable
MYSQL_MIGRATE_CONTAINER_NAME=racingguru-migrate-mysql
MYSQL_MIGRATE_DATABASE_URL=mysql://races:1337@tcp(mysql:3306)/races?multiStatements=true

DB_SYNC_IMAGE_NAME=racingguru-db-sync
DB_SYNC_IMAGE_TAG=latest
DB_SYNC_CONTAINER_NAME=racingguru-db-sync
DB_SYNC_SOURCE=auto
DB_SYNC_DELETE_STALE=false

APP_IMAGE_NAME=racingguru-app
APP_IMAGE_TAG=latest
APP_CONTAINER_NAME=racingguru-app
APP_HOST_ADDR=0.0.0.0
APP_PORT=8080
APP_CONTAINER_PORT=8080
SERVER_ADDR=:8080
DBMS=postgres
APP_POSTGRES_DATABASE_URL=postgresql://postgres:1337@postgres:5432/races?sslmode=disable
APP_MYSQL_DATABASE_URL=races:1337@tcp(mysql:3306)/races?parseTime=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
JWT_SECRET_KEY=change-me-please
LOG_LEVEL=info
LOG_FILE=/logs/app.log

FRONTEND_IMAGE_NAME=racingguru-ui
FRONTEND_IMAGE_TAG=latest
FRONTEND_CONTAINER_NAME=racingguru-ui
FRONTEND_HOST_ADDR=0.0.0.0
FRONTEND_HOST_PORT=4200
FRONTEND_CONTAINER_PORT=80
FRONTEND_SERVER_NAME=_
FRONTEND_BASE_URL=http://localhost:4200
API_BASE_URL=/api
BACKEND_URL=http://app:8080
